{
  "compilerOptions": {
    "target": "esnext",
    "module": "esnext",
    "moduleResolution": "node",
    "resolveJsonModule": true,
    "lib": [
      "ES2024",
      "webworker"
    ],
    "sourceMap": true,
    "rootDir": ".",
    "outDir": "dist",
    "skipLibCheck": true,
    "types": [
      "node"
    ],
    "strict": true
  },
  "include": [
    "src"
  ]
}
  