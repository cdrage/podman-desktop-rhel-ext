{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "skipLibCheck": true,
    "allowJs": true,
    "checkJs": true,
    "esModuleInterop": true,
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "types": ["svelte", "vite/client"],
    "baseUrl": ".",
    "paths": {
      "/@shared/*": ["../shared/*"]
    }
  },
  "include": ["src/**/*.ts", "src/**/*.svelte", "*.config.ts", "../shared/src/**/*.ts"]
}
